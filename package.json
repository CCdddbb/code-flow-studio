{
  "name": "code-flow-studio",
  "version": "0.3.0-alpha.2",
  "private": true,
  "license": "MIT",
  "description": "Local-first, evidence-backed code and data-flow visualization",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "analyze": "node src/cli.js",
    "evidence": "node src/evidence.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "playwright": "~1.56.1"
  }
}
