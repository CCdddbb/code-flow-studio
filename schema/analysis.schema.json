{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-flow-studio.example/schema/analysis-v1.json",
  "title": "Code Flow Studio static analysis model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "sourceSnapshot", "dataMode", "entryStepId", "entries", "entities", "steps", "flows", "contracts", "evidence", "diagnostics", "presentation", "report"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "object", "required": ["name", "languages"], "properties": { "name": { "type": "string", "maxLength": 80 }, "languages": { "type": "array", "items": { "type": "string" }, "maxItems": 3 } }, "additionalProperties": false },
    "sourceSnapshot": { "type": "object", "required": ["id", "files"], "properties": { "id": { "$ref": "#/definitions/hash" }, "files": { "type": "array", "minItems": 1, "maxItems": 120, "items": { "type": "object", "required": ["name", "hash", "bytes", "lines"], "properties": { "name": { "type": "string", "maxLength": 240 }, "hash": { "$ref": "#/definitions/hash" }, "bytes": { "type": "integer", "minimum": 0, "maximum": 200000 }, "lines": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } } }, "additionalProperties": false },
    "dataMode": { "const": "mock" },
    "entryStepId": { "$ref": "#/definitions/id" },
    "entries": { "type": "array", "maxItems": 800, "items": { "type": "object", "required": ["id", "label", "file", "line", "preferred"], "properties": { "id": { "$ref": "#/definitions/id" }, "label": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "preferred": { "type": "boolean" } }, "additionalProperties": false } },
    "entities": { "type": "array", "maxItems": 4000, "items": { "type": "object", "required": ["id", "label", "kind", "basis"], "properties": { "id": { "$ref": "#/definitions/id" }, "label": { "type": "string" }, "kind": { "enum": ["service", "external", "store", "queue"] }, "basis": { "$ref": "#/definitions/basis" }, "unresolved": { "type": "boolean" } }, "additionalProperties": false } },
    "steps": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "object", "required": ["id", "label", "entityId", "basis", "file", "line", "evidenceIds", "parameters", "transforms", "guards", "transaction", "parser"], "properties": {
      "id": { "$ref": "#/definitions/id" }, "label": { "type": "string" }, "entityId": { "$ref": "#/definitions/id" }, "basis": { "$ref": "#/definitions/basis" }, "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "evidenceIds": { "type": "array", "items": { "$ref": "#/definitions/id" } },
      "parameters": { "type": "array", "maxItems": 100, "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "type": "string" } }, "additionalProperties": false } },
      "transforms": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["target", "expression", "line"], "properties": { "target": { "type": "string" }, "expression": { "$ref": "#/definitions/expression" }, "line": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } },
      "guards": { "type": "array", "items": { "type": "object", "required": ["condition", "line", "effect", "basis", "evidenceId"], "properties": { "condition": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "effect": { "type": "string" }, "basis": { "$ref": "#/definitions/basis" }, "evidenceId": { "$ref": "#/definitions/id" } }, "additionalProperties": false } },
      "transaction": { "anyOf": [{ "type": "null" }, { "type": "object", "required": ["basis", "label"], "properties": { "basis": { "$ref": "#/definitions/basis" }, "label": { "type": "string" } }, "additionalProperties": false }] }, "parser": { "enum": ["typescript-ast", "java-lexical"] }
    }, "additionalProperties": false } },
    "flows": { "type": "array", "maxItems": 8000, "items": { "type": "object", "required": ["id", "from", "to", "label", "basis", "resolution", "evidenceId", "line"], "properties": { "id": { "$ref": "#/definitions/id" }, "from": { "$ref": "#/definitions/id" }, "to": { "$ref": "#/definitions/id" }, "label": { "type": "string" }, "basis": { "$ref": "#/definitions/basis" }, "resolution": { "enum": ["static-local", "static-declared-reference", "unresolved"] }, "evidenceId": { "$ref": "#/definitions/id" }, "line": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } },
    "contracts": { "type": "array", "maxItems": 2000, "items": { "type": "object", "required": ["id", "name", "fields", "line", "file", "evidenceIds"], "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "file": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "$ref": "#/definitions/id" } }, "fields": { "type": "array", "items": { "type": "object", "required": ["name", "type", "optional"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "optional": { "type": "boolean" } }, "additionalProperties": false } } }, "additionalProperties": false } },
    "evidence": { "type": "array", "maxItems": 10000, "items": { "type": "object", "required": ["id", "file", "startLine", "endLine", "claim", "fileHash", "excerptHash", "excerpt", "redacted", "truncated", "status"], "properties": { "id": { "$ref": "#/definitions/id" }, "file": { "type": "string" }, "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }, "claim": { "type": "string" }, "fileHash": { "$ref": "#/definitions/hash" }, "excerptHash": { "$ref": "#/definitions/hash" }, "excerpt": { "type": "string" }, "redacted": { "type": "boolean" }, "truncated": { "type": "boolean" }, "status": { "const": "valid" } }, "additionalProperties": false } },
    "diagnostics": { "type": "array", "maxItems": 10000, "items": { "type": "object", "required": ["severity", "code", "message"], "properties": { "severity": { "enum": ["info", "warning", "error"] }, "code": { "type": "string" }, "message": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } },
    "presentation": { "type": "object", "required": ["layout", "playback", "theme"], "properties": { "layout": { "const": "assembly" }, "playback": { "const": "static-outline" }, "theme": { "const": "midnight" } }, "additionalProperties": false },
    "report": { "type": "object", "required": ["files", "functions", "outlinedFunctions", "unresolvedCalls", "sourceStepsWithEvidence", "limitations"], "properties": { "files": { "type": "integer" }, "functions": { "type": "integer" }, "outlinedFunctions": { "type": "integer" }, "unresolvedCalls": { "type": "integer" }, "sourceStepsWithEvidence": { "type": "integer" }, "limitations": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "basis": { "enum": ["source", "inferred", "user-confirmed", "unknown"] },
    "expression": { "oneOf": [
      { "type": "object", "required": ["op", "value"], "properties": { "op": { "const": "literal" }, "value": { "type": ["string", "number", "boolean", "null"] } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "path"], "properties": { "op": { "const": "ref" }, "path": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "not": { "enum": ["__proto__", "prototype", "constructor"] } } } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "fields"], "properties": { "op": { "const": "object" }, "fields": { "type": "array", "maxItems": 300, "items": { "type": "object", "required": ["key", "expression"], "properties": { "key": { "type": "string", "not": { "enum": ["__proto__", "prototype", "constructor"] } }, "expression": { "$ref": "#/definitions/expression" } }, "additionalProperties": false } } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "items"], "properties": { "op": { "const": "array" }, "items": { "type": "array", "maxItems": 300, "items": { "$ref": "#/definitions/expression" } } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "reason"], "properties": { "op": { "const": "unknown" }, "reason": { "type": "string" } }, "additionalProperties": false }
    ] }
  }
}
